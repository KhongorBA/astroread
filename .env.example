# --- QPay мерчант эрх (qpay.mn -> Merchant Dashboard-аас авна) ---
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# Заавал биш: QPay-ийн API хаяг өөрчлөгдвөл энд солино (ихэвчлэн хоослож болно)
QPAY_BASE_URL=https://merchant.qpay.mn/v2

# Нэхэмжлэлийн дүн (₮). Хоослож үлдээвэл 6900 ашиглана
QPAY_AMOUNT=6900

# Заавал биш: төлбөр орсны дараа QPay мэдэгдэл илгээх URL
# (жишээ нь: https://tanii-sait.netlify.app/.netlify/functions/qpay-callback)
QPAY_CALLBACK_URL=

# --- И-мэйл илгээх (Resend) — өмнөх тохиргооноос ---
RESEND_API_KEY=
RESEND_FROM=Astro Read <onboarding@resend.dev>
